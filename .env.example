# Copy this file to .env.local for local development, or set these as
# Environment Variables in the Vercel project settings for production.
# Nothing below is required to run the site — it works with sensible
# defaults until these are set.

# The live production domain, once one is chosen. Used for canonical URLs,
# the sitemap and Open Graph tags. Falls back to a placeholder Vercel URL
# if unset (see src/data/site-config.ts).
NEXT_PUBLIC_SITE_URL=https://www.seasonscafe.ie

# Enables the contact form to actually send emails (see
# src/app/api/contact/route.ts). Get a free API key at https://resend.com,
# verify a sending domain, then set this. Until it's set, the contact form
# still validates submissions but honestly tells visitors it isn't
# connected to email yet, instead of pretending to send.
RESEND_API_KEY=
